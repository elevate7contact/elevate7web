    ],
    trustBadges: [
      { icon: '🔒', label: 'Encrypted payment via Stripe' },
      { icon: '📅', label: 'Pick your time after payment' },
      { icon: '🔄', label: 'Free rescheduling' },
      { icon: '📧', label: 'Email confirmation' },
    ],
    startHere: '🔥 Start here',
    freeName: 'Free assessment',
